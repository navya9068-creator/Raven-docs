# GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional server-side Stripe secret key for real Web/PWA subscription checkout.
# Configure via Secrets panel in production; never expose in client code.
STRIPE_SECRET_KEY=""

# STRIPE_PRICE_MONTHLY: Stripe Price ID for DARK ACADEMIA Monthly Plan ($6.99/mo).
STRIPE_PRICE_MONTHLY=""

# STRIPE_PRICE_ANNUAL: Stripe Price ID for DARK ACADEMIA Annual Plan ($49.99/yr).
STRIPE_PRICE_ANNUAL=""

# STRIPE_WEBHOOK_SECRET: Stripe Webhook signing secret for verifying subscription events.
STRIPE_WEBHOOK_SECRET=""
